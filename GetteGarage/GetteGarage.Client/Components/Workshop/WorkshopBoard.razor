@using MudBlazor
@using GetteGarage.Client.Data
@inject IDialogService DialogService
@inject IJSRuntime JS

@rendermode InteractiveWebAssembly

<!-- Portfolio -->
<MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" @bind-SelectedValues="_selectedTags" CheckMark="true" Class="mb-4">
    @foreach (var tag in _allTags)
    {
        <MudChip Value="@tag">@tag</MudChip>
    }
</MudChipSet> 

<MudGrid>
    @foreach (var project in _filteredProjects)
    {
        <MudItem xs="12" sm="6" md="4" @onclick="() => OpenProject(project)">
            <StudioCard Title="@project.Title"
                        Version="@project.Version"
                        StaticImage="@project.StaticImage"
                        AnimatedGif="@project.AnimatedGif"
                        Tag="@project.Tag"
                        TagColor="@project.TagColor"
                        Description="@project.Description"
                        TechStack="@project.TechStack" 
			/>
        </MudItem>
    }
</MudGrid>


@code {


    private IReadOnlyCollection<string> _selectedTags = new HashSet<string>();

    private List<string> _allTags => StudioProjectData.All
        .Select(p => p.Tag)
        .Distinct()
        .OrderBy(t => t)
        .ToList();

    private IEnumerable<StudioProject> _filteredProjects =>
        _selectedTags.Count == 0
            ? StudioProjectData.All
            : StudioProjectData.All.Where(p => _selectedTags.Contains(p.Tag));
    private void OpenProject(StudioProject item)
    {
        var parameters = new DialogParameters<StudioCardDialog> { { x => x.Item, item } };
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true, NoHeader = true};
        
        DialogService.ShowAsync<StudioCardDialog>(item.Title, parameters, options);
    }
}
    
