@using MudBlazor
@using GetteGarage.Client.Components.Shared
@rendermode InteractiveWebAssembly
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">

    <!-- Intro -->
    <div class="d-flex flex-column flex-md-row align-center gap-6 mb-8">
        <img src="images/profile_mw.png" class="about-photo" alt="Dr. Gette" />

        <div class="text-center text-md-left">
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-1">Dr. Gette</MudText>
            <MudText Typo="Typo.body1" Class="mb-4" Style="font-family: 'Rajdhani'; opacity: 0.85;">
                Professional overthinker. Hobbyist at everything else.
            </MudText>
		<div class="d-flex justify-center justify-md-start mb-8">
        	<MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Chat"
                   OnClick="OpenContact"
                   Class="pulse-button"
                   Style="border: 2px solid rgba(50,153,255,0.6);">
            	SAY HI
        	</MudButton>
    </div>

        </div>
    </div>
    <!-- Bio -->
    <MudText Typo="Typo.body1" Class="mb-2" Style="font-family: 'Rajdhani'; line-height: 1.7;">
        I draw. I paint. I make small games that mostly star a raccoon or a
        very relaxed beach enthusiast. Sometimes I build a piece of software
        for no better reason than "it would be funny," and then spend fifteen
        hours on it instead of the two-minute fix.
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-8" Style="font-family: 'Rajdhani'; line-height: 1.7;">
        This site is where those things live.
    </MudText>

    <!-- Resume, condensed to one line -->
    <MudText Typo="Typo.body1" Class="mb-8" Style="font-family: 'Rajdhani'; opacity: 0.9; font-style: italic;">
        By day, I work in cloud &amp; AI modernization. I also have a PhD in Physics
        and an MS in Astrophysics, which mostly qualifies me to overthink hobbies.
    </MudText>

    <!-- What I make for fun -->
    <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-4">What I Make For Fun</MudText>

    <MudGrid Class="mb-8">
        @foreach (var interest in Interests)
        {
            <MudItem xs="12" sm="6">
                <div class="interest-card" style="border-left: 3px solid @interest.AccentHex;">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@interest.Icon" Style="@($"color:{interest.AccentHex}")" Class="mr-2" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:bold;">@interest.Title</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="font-family: 'Rajdhani'; opacity: 0.85;">
                        @interest.Description
                    </MudText>
                </div>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

<style>
    .about-photo {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 20px rgba(246, 169, 31, 0.2);
	image-rendering: pixelated;
    }

    .interest-card {
        height: 100%;
        padding: 16px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 4px;
        transition: background 0.2s ease;
    }

    .interest-card:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .pulse-button {
        animation: btn-pulse 2s infinite;
    }

    @@keyframes btn-pulse {
        0% { box-shadow: 0 0 0 0 rgba(50,153,255,.9); }
        70% { box-shadow: 0 0 0 10px rgba(50,153,255,0); }
        100% { box-shadow: 0 0 0 0 rgba(50,153,255,0); }
    }
</style>

@code {
    class Interest
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string AccentHex { get; set; } = "";
    }

    private List<Interest> Interests = new()
    {
        new Interest
        {
            Title = "Tiny Games",
            Description = "Built in Godot, published on itch.io. Usually about hitting things with a bat or building a sanctuary for birds.",
            Icon = Icons.Material.Filled.SportsEsports,
            AccentHex = "#f6a91f"
        },
        new Interest
        {
            Title = "Painting & Drawing",
            Description = "I make the occasional D&D character portrait in oils and pixel art mascots for coworkers.",
            Icon = Icons.Material.Filled.Palette,
            AccentHex = "#cf4024"
        },
        new Interest
        {
            Title = "Bad Music",
            Description = "Learning FLStudio and FamiStudio, mostly to make 8-bit beeps my wife has to live with.",
            Icon = Icons.Material.Filled.MusicNote,
            AccentHex = "#2ecc71"
        },
        new Interest
        {
            Title = "Useless Software",
            Description = "Bash scripts, a CLI for this website, and other overengineered fixes to two-second problems.",
            Icon = Icons.Material.Filled.Terminal,
            AccentHex = "#00d9ff"
        },
    };

    private void OpenContact()
    {
        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = true
        };

        DialogService.ShowAsync<ContactDialog>("", options);
    }
}
